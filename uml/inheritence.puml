@startuml
class Product {
- id : Long
- name : String
- price : double
+ getName() : String
+ getPrice() : double
}
class DigitalProduct {
- downloadUrl : String
- fileSizeMB : double
+ getDownloadUrl() : String
}
class PhysicalProduct {
- weightKg : double
- dimensions : String
+ getWeightKg() : double
}
' <|-- is the inheritance arrow. The PARENT goes on the left.
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml